# NC Print / Alfred integration keys for ~/.openclaw/.env (no secrets here).
# Wave 1+: NC_* preferred; FORGE_* still accepted as aliases.

NC_PRINT_ENABLED=1
NC_PRINT_BACKEND=1
NC_PRINT_USE_FORGE_FALLBACK=0
NC_PRINT_MOONRAKER_URL=http://10.0.0.210:7125
NC_PRINT_PRINTER_ID=k1-max
NC_PRINT_PRINTER_NAME=K1Max-Printy-Baby
NC_PRINT_DASHBOARD_URL=https://cloud-vdroners.ddns.net/apps/nc_print/
# Optional: override auto docker-inspect of nc-print-slicer
# NC_PRINT_SLICER_URL=http://172.18.0.2:8080
NC_PRINT_ALERT_TALK_ROOM=
NC_PRINT_WEBHOOK_SECRET_FILE=~/.openclaw/.env.d/forge-webhook.secret
NC_PRINT_PUBLIC_WEBHOOK_URL=https://alfred-vdroners.ddns.net/forge-webhook
# Hourly Talk digest while printing. Quiet hours skip digests only.
NC_PRINT_HOURLY_PROGRESS=1
NC_PRINT_HOURLY_INTERVAL_S=3600
NC_PRINT_MILESTONES=25,50,75
NC_PRINT_QUIET_HOURS=23:00-07:00

# Legacy Forge aliases (optional fallback / relay container names)
FORGE_ENABLED=1
FORGE_API_URL=https://127.0.0.1:3040
FORGE_API_KEY_FILE=~/.openclaw/.env.d/forge-api.secret
FORGE_PRINTER_ID=k1-max
FORGE_DASHBOARD_URL=https://cloud-vdroners.ddns.net/apps/nc_print/
FORGE_ALERT_TALK_ROOM=
FORGE_WEBHOOK_SECRET_FILE=~/.openclaw/.env.d/forge-webhook.secret
FORGE_WEBHOOK_BIND=0.0.0.0
FORGE_WEBHOOK_PORT=8790
FORGE_PUBLIC_WEBHOOK_URL=https://alfred-vdroners.ddns.net/forge-webhook
FORGE_CPM_UPSTREAM_HOST=forge-webhook-relay
FORGE_QUIET_HOURS=23:00-07:00
FORGE_QUIET_CRITICAL_OVERRIDE=1
FORGE_ALERT_MIN_INTERVAL_M=15
FORGE_STUCK_PRINT_H=2
FORGE_SLICER_DOWN_M=10
FORGE_NATIVE_NOTIFY=0
