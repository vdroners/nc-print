<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>nc_print</id>
	<name>NC 3D Print</name>
	<summary>Slice, send, and monitor Klipper/Moonraker 3D prints from Nextcloud</summary>
	<description><![CDATA[NC 3D Print — slice, send, and monitor Klipper/Moonraker 3D printers from Nextcloud.

Requires a Moonraker-connected printer and the optional nc-print-slicer sidecar container for in-browser slicing (see docs/INSTALL.md). No NC-GCS dependency.]]></description>
	<version>1.60.3</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="dan@19labs.com">19labs</author>
	<namespace>NcPrint</namespace>
	<category>tools</category>
	<website>https://github.com/vdroners/nc-print</website>
	<bugs>https://github.com/vdroners/nc-print/issues</bugs>
	<repository type="git">https://github.com/vdroners/nc-print.git</repository>
	<documentation>https://github.com/vdroners/nc-print/blob/main/README.md</documentation>
	<screenshot>https://raw.githubusercontent.com/vdroners/nc-print/main/docs/screenshots/prepare.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/vdroners/nc-print/main/docs/screenshots/slice.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/vdroners/nc-print/main/docs/screenshots/print.png</screenshot>
	<dependencies>
		<php min-version="8.1" max-version="8.4"/>
		<database>sqlite</database>
		<database>mysql</database>
		<database>pgsql</database>
		<lib>curl</lib>
		<nextcloud min-version="28" max-version="34"/>
	</dependencies>
	<navigations>
		<navigation>
			<name>NC 3D Print</name>
			<route>nc_print.page.index</route>
			<icon>app.svg</icon>
			<order>85</order>
		</navigation>
	</navigations>
	<activity>
		<settings>
			<setting>OCA\NcPrint\Activity\Setting</setting>
		</settings>
		<providers>
			<provider>OCA\NcPrint\Activity\Provider</provider>
		</providers>
	</activity>
</info>
