+// Objects that cannot be status-subscribed (no get_status). Subscribing to
+// any one of these causes Klipper to reject the entire subscribe request.
+const SUBSCRIPTION_DENY_EXACT = new Set([
+  'configfile', 'query_endstops', 'manual_probe', 'custom_macro',
+  'product_param', 'exclude_object', 'respond',
+]);
+
+// Core telemetry objects for HTTP polling and static WS fallback.
+const CORE_TELEMETRY_OBJECTS = [
+  'print_stats', 'virtual_sdcard', 'display_status',
+  'heater_bed', 'extruder', 'extruder1', 'extruder2', 'extruder3',
+  'fan', 'toolhead', 'gcode_move', 'motion_report',
+  'heaters', 'system_stats', 'webhooks', 'idle_timeout',
+  'bed_mesh', 'mcu', 'probe', 'pause_resume',
+  'filament_switch_sensor filament_sensor',
+  'filament_switch_sensor filament_sensor_2',
+  'filament_switch_sensor runout',
+  'filament_motion_sensor filament_sensor',
+  'heater_fan hotend_fan',
+  'temperature_sensor mcu_temp',
+  'temperature_sensor chamber_temp',
+  'temperature_fan chamber_fan',
+  'output_pin fan0', 'output_pin fan1', 'output_pin fan2',
+  'output_pin LED', 'output_pin power',
+  'fan_feedback',
+];
+
+function isSubscribableKlipperObject(name) {
+  if (SUBSCRIPTION_DENY_EXACT.has(name)) return false;
+  if (name.startsWith('gcode_macro ')) return false;
+  // Secondary MCU nodes (mcu nozzle_mcu, etc.) have no get_status.
+  if (name.startsWith('mcu ') && name !== 'mcu') return false;
+  return true;
+}
+
+function filterSubscribableObjects(available) {
+  const filtered = available.filter(isSubscribableKlipperObject);
+  const set = new Set(filtered);
+  for (const obj of CORE_TELEMETRY_OBJECTS) {
+    if (available.includes(obj)) set.add(obj);
+  }
+  return [...set];
+}
